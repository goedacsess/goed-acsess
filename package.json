{
  "name": "iservis-pro",
  "version": "2.7.9",
  "description": "Software Kasir Servis iPhone",
  "main": "main.js",
  "author": "Goed Access",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64 --config.directories.output=dist/win",
    "publish:mac": "electron-builder --mac --publish always",
    "publish:win": "electron-builder --win --x64 --config.directories.output=dist/win --publish always",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/cli": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "@capacitor/filesystem": "^5.2.2",
    "@capacitor/ios": "^5.7.8",
    "@capacitor/share": "^5.0.8",
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "^3.1.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.iservis.pro",
    "productName": "Goed Access",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!src/**/*.backup",
      "build/**/*",
      "!build/ios/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "goedacsess",
      "repo": "goed-acsess",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Aplikasi ini membutuhkan akses kamera untuk fitur absensi wajah karyawan."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh"
    },
    "afterPack": "scripts/fuses.js",
    "afterSign": "scripts/notarize.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "allowScripts": {
    "electron@44.9.3": true
  }
}
